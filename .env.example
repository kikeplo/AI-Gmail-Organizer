# AI provider (provider-agnostic; OpenAI-compatible, Gemini, Anthropic, OpenRouter, etc.)
AI_PROVIDER=
OPENAI_API_KEY=
# Optional backup keys. Keep OPENAI_API_KEY as the primary key.
# You can also use OPENAI_API_KEYS=key1,key2,key3 for a pool.
OPENAI_API_KEY_BACKUP=
OPENAI_API_KEY_BACKUP_2=
OPENAI_API_KEY_BACKUP_3=
OPENAI_API_KEY_BACKUP_4=
OPENAI_API_KEYS=
OPENAI_BASE_URL=
OPENAI_MODEL=
AI_FALLBACK_MODELS=
AI_TRANSIENT_RETRIES=1
AI_RETRY_BASE_SECONDS=0.8

# Local AI (optional; Ollama-compatible by default)
LOCAL_AI_ENABLED=1
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=qwen3:4b
# Default routing: local AI first, cloud automatically when local is unavailable.
AI_ROUTING_MODE=local-first
AI_PROVIDER_PRIORITY=local,cloud

# Gmail browser sign-in
# Set these once for the desktop OAuth application. The app then opens
# Google's normal account sign-in page; users never enter their password here.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Local storage
MEMORY_DB_PATH=
