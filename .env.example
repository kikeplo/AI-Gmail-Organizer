# AI provider (provider-agnostic; OpenAI-compatible, Gemini, Anthropic, Ollama, etc.)
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Gmail browser sign-in
# Set these once for the desktop OAuth application. The app then opens
# Google's normal account sign-in page; users never enter their password here.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Local storage
MEMORY_DB_PATH=
